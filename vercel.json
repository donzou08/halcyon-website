{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/theworks/demos/:slug", "destination": "/theworks/demos/:slug/index.html" },
    { "source": "/theworks", "destination": "/theworks/index.html" },
    { "source": "/theworks/:path*", "destination": "/theworks/index.html" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
